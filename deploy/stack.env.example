# Portainer: Stacks -> homebox -> "Environment variables" (Advanced mode lets
# you paste this whole block). Values in <> must be replaced.

TZ=Europe/Berlin

# --- Homebox ---
# Same value as in your current Homebox stack, if you had one.
HBOX_AUTH_API_KEY_PEPPER=<long random string, e.g. openssl rand -hex 32>
HBOX_ALLOW_REGISTRATION=false
HOMEBOX_PORT=3100
# Existing data volume of your current Homebox stack (Portainer -> Volumes).
HOMEBOX_DATA_VOLUME=homebox-data

# --- Backup (encrypted, OneDrive) ---
BACKUP_REMOTE=onedrive:Backups/homebox
BACKUP_PASSWORD=<long random passphrase – also into your password manager!>
BACKUP_SALT=<second long random passphrase – also into your password manager!>
BACKUP_SCHEDULE=30 3 * * *
# Used until interval/retention are set in Homebox (Collection → Tools).
BACKUP_KEEP_DAYS=60
BACKUP_KEEP_MIN=10
BACKUP_LOCAL_KEEP=3
BACKUP_HEALTHCHECK_URL=
